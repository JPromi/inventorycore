# Copy to .env next to docker-compose.yml. Never commit the real .env.
# The passwords below are defaults for a first test: change them before real use.

# image tag: latest (releases), beta (manual builds) or a version such as 1.2.0
INVENTORYCORE_TAG=latest
APP_PORT=8080

DB_NAME=inventorycore
DB_USER=inventorycore
DB_PASSWORD=inventorycore

# local admin, created on the first start only (changing it later does not reset the password)
DEFAULT_ADMIN_USERNAME=inv
DEFAULT_ADMIN_PASSWORD=core

# contact address for the public Nominatim server (address search for locations)
NOMINATIM_EMAIL=
TZ=Europe/Vienna
